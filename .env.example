# Public site URL (used for OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only — never expose service role key to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Places API for live restaurant search
GOOGLE_PLACES_API_KEY=

# Dashboard password (simple shared-secret protection for /dashboard)
DASHBOARD_PASSWORD=change-me-please
